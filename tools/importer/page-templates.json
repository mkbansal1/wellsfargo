          "selector": "main >.card-background-white:nth-of-type(4)",
          "style": null,
          "blocks": ["contact-info"],
          "defaultContent": []
        },
        {
          "id": "section-11-quickhelp",
          "name": "Quick Help",
          "selector": "main >.enhanced-txt-cm.text-aligned-left:nth-of-type(1)",
          "style": null,
          "blocks": [],
          "defaultContent": ["h3", "ul"]
        },
        {
          "id": "section-12-footnotes",
          "name": "Footnotes",
          "selector": ".ps-footnote",
          "style": null,
          "blocks": ["disclaimers"],
          "defaultContent": []
